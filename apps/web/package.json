{
	"name": "history-timeline-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/bundle-db-scripts.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"db:start": "docker compose up db -d",
		"docker:up": "docker compose up --build",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "DB_MIGRATING=true tsx --env-file-if-exists=.env src/lib/server/databases/postgres/migrate.ts",
		"db:bootstrap-admin": "DB_BOOTSTRAPPING_ADMIN=true tsx --env-file-if-exists=.env src/lib/server/databases/postgres/bootstrap-admin.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:seed": "DB_SEEDING=true tsx --env-file-if-exists=.env src/lib/server/databases/postgres/seed.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@biomejs/biome": "^2.5.4",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg-pool": "^2.0.7",
		"@vitest/coverage-v8": "^4.1.12",
		"better-auth": "~1.4.21",
		"dotenv": "^16.6.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"esbuild": "^0.28.1",
		"postgres": "^3.4.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.19.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"ioredis": "^5.11.1",
		"pg": "^8.23.0",
		"pg-pool": "^3.14.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.2.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.6.7"
	}
}
